# Senha única de acesso ao app
APP_PASSWORD=troque-esta-senha
# Segredo que sela o cookie de sessão (mínimo 32 caracteres; gere com: openssl rand -base64 32)
NUXT_APP_SECRET=troque-por-um-segredo-com-32-ou-mais-caracteres
# Caminho do banco SQLite
DATABASE_PATH=./data/app.db
# Agenda da coleta (cron, fuso America/Sao_Paulo)
COLLECT_CRON=0 */3 * * *
# Desligar o agendador (ex.: em testes): false
COLLECT_ENABLED=true
# Proxy opcional por loja, se a loja bloquear o servidor
# PROXY_URL_AMAZON=http://usuario:senha@proxy:porta
# PROXY_URL_MERCADOLIVRE=
# PROXY_URL_KABUM=
# Domínio usado pelo Caddy (HTTPS automático)
DOMAIN=localhost
